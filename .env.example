# Bu dosyayi .env olarak kopyalayip gercek degerleri girin. .env asla commit edilmez.

# Veritabani
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/asistan

# SearXNG
SEARXNG_SECRET_KEY=change-me
SEARXNG_URL=http://localhost:8080/search

# Harici API anahtarlari
YOUTUBE_API_KEY=
RESEND_API_KEY=
OPENWEATHER_API_KEY=
ELEVENLABS_API_KEY=

# Microsoft / Outlook OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Admin paneli
ADMIN_TOKEN=

# Google OAuth: data/google_credentials.json ve data/google_web_credentials.json
# dosyalarini Google Cloud Console'dan indirip data/ klasorune koyun (git'e eklenmez).

# Diger
LLM_MODEL=qwen2.5:7b
WEATHER_CITY=Istanbul
PIPER_MODEL_PATH=E:\Project\tr_TR-dfki-medium.onnx
CHROMEDRIVER_PATH=E:\Project\chromedriver.exe
